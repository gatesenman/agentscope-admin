#!/usr/bin/env bash
#
# Convenience wrapper for the AgentScope Admin CLI.
#
# Runs `python -m app.cli` inside the server virtualenv (creating/activating
# .venv if present) so you can use the CLI straight from a source checkout
# without `pip install`.
#
#   ./agentscope-admin agents list
#   ./agentscope-admin workflow run <id> --input query="hello"
#
# If you prefer a globally installed command, run `pip install -e .` in this
# directory instead, which exposes `agentscope-admin` on your PATH.
#
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

if [ -d .venv ]; then
  # shellcheck disable=SC1091
  source .venv/bin/activate
fi

exec python -m app.cli "$@"
